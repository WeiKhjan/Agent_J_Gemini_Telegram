# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Security - Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_TELEGRAM_IDS=123456789

# Working directory for Gemini CLI (where files are created/modified)
WORKSPACE_DIR=./workspace

# Server port (default: 3001 to avoid conflict with other bots)
PORT=3001

# Webhook URL (optional - for production. If not set, uses polling)
# WEBHOOK_URL=https://your-domain.com/webhook

# NOTE: No API key needed! Gemini CLI uses Google login.
# Run 'gemini' in terminal first to authenticate with your Google account.
